{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: preparar CronoSys",
            "type": "shell",
            "command": "mvn",
            "args": ["clean", "package", "-DskipTests"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "Maven: ejecutar CronoSys (javafx:run)",
            "type": "shell",
            "command": "mvn",
            "args": ["javafx:run"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
